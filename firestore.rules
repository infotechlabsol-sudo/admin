rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-All Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Secure Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Leads collection: read and write access for authenticated admins
    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // 2. Students collection
    match /students/{studentId} {
      allow read: if true; 
      allow create, update, delete: if isSignedIn();
    }

    // 3. Payments collection
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // 4. Counters collection for atomic serial registration numbering
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 5. Expenses collection
    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // 6. Courses collection (shared with Tech Lab CRM)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 7. Batches collection (shared with Tech Lab CRM)
    match /batches/{batchId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
